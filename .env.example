# ─────────────────────────────────────────────
# ITS Diner — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your real .env to version control.
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
# Port the Express API server listens on.
PORT=5000

# URL of the frontend (used for CORS). Change to
# your production domain when deploying.
CLIENT_URL=http://localhost:5173

# Secret used to sign JWT authentication tokens.
# Generate a strong random string (e.g. openssl rand -hex 32).
# REQUIRED in production — the default is insecure.
JWT_SECRET=replace-with-a-secure-random-string

# ── Stripe Payments ──────────────────────────
# Leave both blank to use the built-in test checkout.
# Get keys from https://dashboard.stripe.com/apikeys

# Server-side secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# Client-side publishable key (pk_live_... or pk_test_...)
# Must be prefixed VITE_ so Vite exposes it to the browser.
VITE_STRIPE_PUBLISHABLE_KEY=

# ── SMTP Email ───────────────────────────────
# When configured, order confirmations and notifications
# are sent as real emails. If left blank, emails are
# written to data/email-log.json instead.
#
# Common providers:
#   Gmail:    smtp.gmail.com  port 587  (use App Password)
#   Outlook:  smtp.office365.com  port 587
#   Mailgun:  smtp.mailgun.org  port 587
#   SendGrid: smtp.sendgrid.net  port 587  user=apikey

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The "From" address shown in sent emails.
EMAIL_FROM=noreply@itsdiner.local

# ── Route / Van Mode ─────────────────────────
# How many minutes the van stays at each stop
# before automatically advancing to the next one.
ROUTE_STOP_MINUTES=20
